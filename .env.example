# Base URL for the REST API (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://profootball.srv883830.hstgr.cloud

# WebSocket (Socket.IO) URL
NEXT_PUBLIC_WS_URL=wss://profootball.srv883830.hstgr.cloud

# This app's own deployed URL (no trailing slash), used for metadata,
# Open Graph tags, robots.txt, and the sitemap. Falls back to
# http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.example
